# Copy to .env before building. Metro inlines EXPO_PUBLIC_* at bundle time.
# Without EXPO_PUBLIC_ZEST_API_URL the app keeps the template's local-only behaviour.
EXPO_PUBLIC_ZEST_API_URL=http://127.0.0.1:8787
# Must match ZEST_APP_TOKEN on the Worker when that secret is set.
EXPO_PUBLIC_ZEST_APP_TOKEN=change-me
