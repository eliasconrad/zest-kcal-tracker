{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zest-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zest",
      "database_id": "775d2904-73e6-44d7-992f-9e1fefba860c",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Open-weights vision model on OpenRouter. Swap freely; the app never sees it.
    "OPENROUTER_MODEL": "qwen/qwen2.5-vl-72b-instruct",
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
    "ZEST_MAX_IMAGE_BYTES": "6000000",
    "ZEST_BUNDLE_ID": "eu.eliasconrad.zest",
    "FREE_SCANS_PER_DAY": "3",
    "FREE_ASKS_PER_DAY": "10"
  }
  // Secrets (never in this file):
  //   wrangler secret put OPENROUTER_API_KEY
  //   wrangler secret put ZEST_APP_TOKEN      (shared with the app; optional but recommended)
  //   wrangler secret put RESEND_API_KEY      (password reset mails)
  //   wrangler secret put EXPO_ACCESS_TOKEN   (optional, for friend nudges through Expo Push)
}
